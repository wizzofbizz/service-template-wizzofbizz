# =============================================================================
# Service Booking Template — environment configuration
#
# Copy to .env and fill in. Only the REQUIRED block is needed to run:
# every integration below it is optional, and the app boots and takes
# bookings with all of them unset.
#
#   cp .env.example .env
#   npm install && npm run db:push && npm run db:seed && npm run dev
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# Any PostgreSQL 14+. Works with Docker, Coolify, a managed instance or Neon.
# Local/Docker hosts connect without TLS; remote hosts use TLS automatically.
DATABASE_URL=postgresql://postgres:password@localhost:5432/servicetemplate

# Signs session cookies. Generate a fresh one per deployment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# The public origin, no trailing slash. Every customer-facing link (quotes,
# invoices, booking confirmations, payment redirects) is built from this, so a
# wrong value sends customers to the wrong host. REQUIRED in production.
PUBLIC_BASE_URL=http://localhost:5000

NODE_ENV=development
PORT=5000

# -----------------------------------------------------------------------------
# ENCRYPTION — required if you use WhatsApp
# -----------------------------------------------------------------------------
# Encrypts stored provider tokens. Must be STABLE: if it changes, previously
# encrypted values become permanently unreadable. Required in production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=

# -----------------------------------------------------------------------------
# SEEDING
# -----------------------------------------------------------------------------
# Password for the demo admin created by `npm run db:seed` (min 12 chars).
# There is deliberately no default. Change it after first login.
SEED_ADMIN_PASSWORD=

# Pins the deployment to a specific business row. Leave blank to use the only
# row in the table — correct for virtually every install.
BUSINESS_ID=

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
# How customers book:
#   quote_first  describe the job -> AI/rule quote -> accept -> book (trades)
#   direct       pick a service -> pick a slot (salon, tutor, physio)
#   quote_only   quoting with no calendar booking
BOOKING_MODE=quote_first

ENABLE_INVOICING=true
ENABLE_DEPOSITS=false
ENABLE_AI_QUOTING=true
ENABLE_WHATSAPP=false

# -----------------------------------------------------------------------------
# BRANDING (VITE_* are inlined at BUILD time — rebuild after changing)
# -----------------------------------------------------------------------------
VITE_SITE_NAME=Your Business
VITE_SITE_TAGLINE=Book professional services online in minutes.
VITE_PUBLIC_BASE_URL=http://localhost:5000
VITE_LOGO_URL=
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=

VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_TWITTER=
VITE_SOCIAL_LINKEDIN=

# Locale. Defaults suit South Africa; override for other markets.
VITE_CURRENCY_SYMBOL=R
VITE_CURRENCY_CODE=ZAR
VITE_COUNTRY_CODE=ZA
VITE_COUNTRY_NAME=South Africa

# Must match BOOKING_MODE above.
VITE_BOOKING_MODE=quote_first
VITE_ENABLE_INVOICING=true
VITE_ENABLE_DEPOSITS=false
VITE_ENABLE_WHATSAPP=false

# The brand colour is NOT an env var: set --brand in client/src/index.css
# (both the :root and dark-mode blocks). One edit rethemes the whole app.

# -----------------------------------------------------------------------------
# OPTIONAL — EMAIL
# Without this, notifications are queued in the database but never sent.
# -----------------------------------------------------------------------------
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# -----------------------------------------------------------------------------
# OPTIONAL — AI QUOTING
# Without a key, quotes fall back to each service's configured pricing rules
# and are flagged low-confidence for the owner to review.
# Get one at https://aistudio.google.com/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL — GOOGLE SIGN-IN
# Without these, the Google button is hidden and email/password login is used.
# Authorised redirect URI: <PUBLIC_BASE_URL>/api/callback
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# OPTIONAL — GOOGLE MAPS (address autocomplete + travel-distance pricing)
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL — PAYFAST (South African payments)
# PAYFAST_MODE=live uses the PROD credentials; anything else uses SANDBOX.
# The sandbox values below are PayFast's own public test credentials.
# -----------------------------------------------------------------------------
PAYFAST_MODE=sandbox
PAYFAST_SANDBOX_MERCHANT_ID=10000100
PAYFAST_SANDBOX_MERCHANT_KEY=46f0cd694581a
PAYFAST_SANDBOX_PASSPHRASE=
PAYFAST_PROD_MERCHANT_ID=
PAYFAST_PROD_MERCHANT_KEY=
PAYFAST_PROD_PASSPHRASE=

# -----------------------------------------------------------------------------
# OPTIONAL — WHATSAPP (choose one provider)
# -----------------------------------------------------------------------------
WASENDER_PERSONAL_ACCESS_TOKEN=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# -----------------------------------------------------------------------------
# SCHEDULER (automated follow-ups)
# Sends quote follow-ups, appointment and deposit reminders, overdue-invoice
# notices, and flushes the outbound email queue. On by default.
# Set false when running more than one instance so only one of them sends.
# -----------------------------------------------------------------------------
ENABLE_SCHEDULER=true
SCHEDULER_TIMEZONE=Africa/Johannesburg
# Cron expressions. Defaults: reminders 09:00 daily, email queue every 5 min.
SCHEDULER_REMINDERS_CRON=0 9 * * *
SCHEDULER_EMAIL_CRON=*/5 * * * *

# -----------------------------------------------------------------------------
# OPTIONAL — GOOGLE CALENDAR SYNC
# Reads the owner's busy times so booked-out slots are never offered, and
# writes confirmed bookings to their calendar.
#
# Setup (see DEPLOY.md for the full walkthrough):
#   1. Google Cloud Console -> create a project
#   2. Enable the Google Calendar API
#   3. Create a Service Account, then a JSON key for it
#   4. Share the business calendar with the service account's email address,
#      granting "Make changes to events"
#   5. Paste the JSON below (single line) and set the calendar id
#
# Without these the built-in calendar handles availability on its own.
# -----------------------------------------------------------------------------
ENABLE_GOOGLE_CALENDAR=false
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternative to the JSON above: a path to the key file.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=

# -----------------------------------------------------------------------------
# FILE UPLOADS
# Where uploaded images are stored. In Docker this must be a mounted volume,
# or uploads are lost on redeploy.
# -----------------------------------------------------------------------------
UPLOAD_DIR=./uploads

# -----------------------------------------------------------------------------
# DOCKER COMPOSE ONLY
# Used by docker-compose.yml to provision the bundled Postgres container.
# Ignored when you point DATABASE_URL at an external database.
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=servicetemplate
POSTGRES_PORT=5432
APP_PORT=5000
